{
  "name": "guessfi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n worker,client -c magenta,cyan \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:worker": "wrangler dev",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "npm run packs && vite build",
    "deploy": "npm run build && wrangler deploy",
    "packs": "tsx scripts/build-packs.ts",
    "demo-pack": "tsx scripts/make-demo-pack.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "sharp": "^0.35.3",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.120.0"
  }
}
