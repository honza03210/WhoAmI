{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guessfi",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-01",

  "vars": {
    // Public. The OAuth2 client secret lives in `.dev.vars` / `wrangler secret`, never here.
    "DISCORD_CLIENT_ID": "1535978877573406841"
  },

  // One room per Discord activity instance. SQLite-backed so it is available on the free plan.
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The client is a single-page app: unknown paths serve index.html rather than 404.
    "not_found_handling": "single-page-application",
    // Everything not listed here is served straight off the asset layer, which is free and
    // unmetered. "/.proxy/*" is defensive: with a root URL mapping Discord forwards bare
    // paths, but some proxy setups keep the prefix, and the Worker strips it either way.
    "run_worker_first": ["/api/*", "/.proxy/*"]
  },

  "observability": {
    "enabled": true
  }
}
